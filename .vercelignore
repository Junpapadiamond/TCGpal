# Ship only application source, assets and build configuration. Applies to
# Git and CLI deployments; local reports, screenshots and caches stay out.
/*
!src/
!public/
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!postcss.config.mjs
!sentry.server.config.ts
!sentry.edge.config.ts
!vercel.json
!.vercelignore

# Run the release gate in the complete checkout, where research/test inputs
# exist. Vercel builds the application with `npm run build` only.
src/**/*.test.*
src/**/*.bench.*
