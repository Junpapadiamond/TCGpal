{
  "name": "tcgpal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "catalog:freshness": "node scripts/check-catalog-freshness.mjs",
    "catalog:freshness:check": "node scripts/check-catalog-freshness.mjs --check",
    "check:tavily": "node scripts/check-tavily.mjs",
    "frontier:firecrawl:evaluate": "node scripts/frontier-research/firecrawl/evaluate.mjs",
    "metadata:audit": "node scripts/audit-one-piece-exact-prints.mjs",
    "metadata:check": "node scripts/audit-one-piece-exact-prints.mjs --check",
    "metadata:refresh": "node scripts/research-one-piece-exact-prints.mjs && node scripts/audit-one-piece-exact-prints.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run metadata:check && vitest run",
    "benchmark:print-fidelity": "vitest bench src/lib/comparison/print-fidelity.bench.ts --run",
    "verdict:review": "AI_VERDICT_NOTE=1 VERDICT_NOTE_REVIEW=1 vitest run src/lib/ai/verdict-note-review.test.ts",
    "measure:buy-accuracy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/measure-one-piece-buy-accuracy.mjs",
    "measure:market-anchor": "node scripts/measure-market-anchor.mjs",
    "measure:print-recall": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/measure-print-recall.mjs",
    "review:detail-budget": "EBAY_DETAIL_REVIEW=1 vitest run src/lib/external/ebay-detail-budget-review.test.ts",
    "sample:base-proof": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sample-base-print-precision.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@sentry/nextjs": "^10.63.0",
    "@upstash/redis": "^1.38.0",
    "clsx": "^2.1.1",
    "mcp-handler": "^1.1.0",
    "next": "16.2.6",
    "openai": "^6.39.0",
    "posthog-js": "^1.236.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "jiti": "^2.6.1",
    "one-piece-card-game-json": "^0.2.50",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
