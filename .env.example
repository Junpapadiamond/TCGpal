AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-2026-04-23
OPENAI_MODEL_REVIEW=gpt-5.5-2026-04-23
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_CHEAP=
OPENAI_BASE_URL=https://api.openai.com/v1
# "responses" (default) or "chat" for OpenAI-compatible Chat Completions providers.
OPENAI_WIRE_API=responses
OPENAI_REASONING_EFFORT=xhigh
OPENAI_DISABLE_RESPONSE_STORAGE=true

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-4-8

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Cross-platform comparison runs the deterministic platform fan-out by default.
# Set to 1 to also let a model act as the multi-agent market allocator (drives the
# same platform tools through the runAgent harness; the deterministic fan-out stays
# the guaranteed floor and fallback).
COMPARISON_AGENT=0
# The allocator is a cheap-model tool-routing job, configured INDEPENDENTLY of the
# (best-model) evidence narrative above — point it at any OpenAI-compatible endpoint,
# including a Chinese provider (GLM/Kimi/DeepSeek). Defaults to the OpenAI cheap model.
#   COMPARISON_AGENT_API=chat        # "chat" (default, broadly compatible) or "responses" (OpenAI only)
#   COMPARISON_AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   COMPARISON_AGENT_MODEL=glm-4-flash
#   COMPARISON_AGENT_API_KEY=

POKEMON_TCG_API_KEY=
PRICECHARTING_API_TOKEN=
ONE_PIECE_TCG_API_BASE_URL=https://www.optcgapi.com/api

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
