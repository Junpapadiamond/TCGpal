AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Non-primary roles (classifier, critic) resolve OPENAI_MODEL_REVIEW first, then
# OPENAI_MODEL_CHEAP, then OPENAI_MODEL — see getModelForStep in src/lib/ai/config.ts.
OPENAI_MODEL_REVIEW=gpt-5.6-luna
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_CHEAP=
OPENAI_BASE_URL=https://api.openai.com/v1
# "responses" (default) or "chat" for OpenAI-compatible Chat Completions providers.
OPENAI_WIRE_API=responses
OPENAI_REASONING_EFFORT=xhigh
OPENAI_DISABLE_RESPONSE_STORAGE=true

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-4-8

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Shared operational infrastructure. Without Upstash credentials the app falls
# back to per-process memory, which is fine locally but not shared across Vercel
# instances. Redis is required for stable 30-day result-receipt links.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
RATE_LIMIT_COMPARE_MAX=20
RATE_LIMIT_COMPARE_WINDOW_MS=600000
RATE_LIMIT_IDENTITY_MAX=60
RATE_LIMIT_IDENTITY_WINDOW_MS=600000
RATE_LIMIT_DISCOVERY_MAX=10
RATE_LIMIT_DISCOVERY_WINDOW_MS=600000
RATE_LIMIT_EXPLAIN_MAX=60
RATE_LIMIT_EXPLAIN_WINDOW_MS=600000
RATE_LIMIT_MCP_MAX=60
RATE_LIMIT_MCP_WINDOW_MS=600000
OPERATIONAL_LOGGING=1

# Optional Sentry setup. Source maps upload only when SENTRY_AUTH_TOKEN is set.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_VERCEL_ENV=

# Cross-platform comparison runs the deterministic platform fan-out by default.
# Set to 1 to also let a model act as the multi-agent market allocator (drives the
# same platform tools through the runAgent harness; the deterministic fan-out stays
# the guaranteed floor and fallback).
COMPARISON_AGENT=0

# The AI-written Action note under the buy/wait/pass label. Off by default: the
# deterministic sentence in verdict-copy.ts is the shipped copy. With this on,
# the model may only rewrite that one sentence from a numbered fact sheet, and a
# deterministic checker discards any note containing a number the fact sheet did
# not state. The client has its own AI_VERDICT_NOTE_UI_ENABLED flag.
AI_VERDICT_NOTE=0
# The allocator is an AI tool-routing job, configured INDEPENDENTLY of the evidence
# narrative above — point it at any OpenAI-compatible endpoint. Defaults to the
# primary model and can fall back to a cheaper model if the provider/model fails.
#   COMPARISON_AGENT_API=chat        # "chat" (default, broadly compatible) or "responses" (OpenAI only)
#   COMPARISON_AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   COMPARISON_AGENT_MODEL=gpt-5.5
#   COMPARISON_AGENT_FALLBACK_MODEL=gpt-5.4
#   COMPARISON_AGENT_API_KEY=

POKEMON_TCG_API_KEY=
PRICECHARTING_API_TOKEN=
TAVILY_API_KEY=
EXA_API_KEY=
# Set to 0 to disable experimental Exa/Tavily marketplace URL discovery.
WEB_DISCOVERY=1
ONE_PIECE_TCG_API_BASE_URL=https://www.optcgapi.com/api

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Whatnot active buy-now listings via the Apify provider actor. Optional and off
# by default: with no token the Whatnot agent stays out of the fan-out entirely.
# Whatnot publishes no shipping cost before checkout, so these rows are shown but
# never rank for landed cost.
WHATNOT_APIFY_TOKEN=
