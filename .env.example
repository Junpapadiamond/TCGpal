AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-2026-04-23
OPENAI_MODEL_REVIEW=gpt-5.5-2026-04-23
OPENAI_MODEL_PRIMARY=
OPENAI_MODEL_CHEAP=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=xhigh
OPENAI_DISABLE_RESPONSE_STORAGE=true

ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-4-8

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Cross-platform comparison runs the deterministic platform fan-out by default.
# Set to 1 to also let the AI provider act as the multi-agent market allocator
# (drives the same platform tools through the runAgent harness; the deterministic
# fan-out stays the guaranteed floor and fallback). Requires an AI provider key.
COMPARISON_AGENT=0

POKEMON_TCG_API_KEY=
PRICECHARTING_API_TOKEN=
ONE_PIECE_TCG_API_BASE_URL=https://www.optcgapi.com/api

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
